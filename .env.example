# Copy to .env and fill in whichever providers you want the playground to reach.
# Loom picks these up through Loom.from_env(); none are required to run the
# dashboard in demo mode.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Where captured events are persisted.
LOOM_EVENTS_DB=loom_events.db

# Start the synthetic traffic generator on boot (1 to enable).
DEMO_MODE=0

PORT=5001
